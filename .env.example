# Dedicated PostgreSQL database for VTU-owned data.
# Keep the real connection string in .env; never commit credentials.
# Provider secrets are encrypted with a separate 32-byte base64 key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Public base URL used to build provider webhook URLs, with no trailing slash.
APP_URL=https://yourdomain.com
# Protects /api/cron/fail-pending. Send as Authorization: Bearer <CRON_SECRET>.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
PROVIDER_SECRET_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vtu?sslmode=require
