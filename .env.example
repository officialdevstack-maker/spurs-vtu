# Dedicated PostgreSQL database for VTU-owned data.
# Keep the real connection string in .env; never commit credentials.
# Provider secrets are encrypted with a separate 32-byte base64 key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Public base URL used to build provider webhook URLs, with no trailing slash.
APP_URL=https://yourdomain.com
# OIDC issuer from the node-accounts deployment.
SPURS_ISSUER=https://node-accounts-backend.onrender.com/api/oidc
# Register this app with node-accounts using <APP_URL>/auth/callback as its redirect URI.
SPURS_CLIENT_ID=
# Mobile app OIDC client IDs registered with node-accounts, comma separated.
SPURS_MOBILE_CLIENT_IDS=
# Set this only when the registered node-accounts client is confidential.
SPURS_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SPURS_SESSION_SECRET=
# Protects /api/cron/fail-pending. Send as Authorization: Bearer <CRON_SECRET>.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
PROVIDER_SECRET_KEY=
# Secret mixed into transaction PIN hashes before hashing. Use at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_PEPPER=
# Signs public receipt links. Use at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECEIPT_SECRET=
# Email via Resend. MAIL_FROM must be a verified sender, e.g. "Spur VTU <hello@yourdomain.com>".
RESEND_API_KEY=
MAIL_FROM=
# SMS via Termii (approved sender ID).
TERMII_API_KEY=
TERMII_SENDER_ID=
# Web push. Generate keys with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: address push services can contact.
VAPID_SUBJECT=mailto:support@yourdomain.com
# Set these two values when a Spurs Business workspace asks you to verify this site.
SPURS_BUSINESS_WORKSPACE_ID=
SPURS_BUSINESS_VERIFY_TOKEN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vtu?sslmode=require
BUSINESS_INTERNAL_API_SECRET=
